# See ../setup.sh for the format.
#
# One environment per arm. `proclaim` runs the Verifier Agent and installs
# anywhere; `proclaim-pipeline` is ProClaim's own Linux-and-CUDA stack, so it is
# optional and a laptop can still run arm 1.
#
# Our librarian backend lives in backend/ and is grafted onto the clone at run
# time by direct_entry.py. See NOTICE.
bench=proclaim
name=ProClaim
url=https://github.com/saezlab/ProClaim.git
commit=6316258ba31386657389fea5bb2db2c97362e06c
clone=ProClaim_src
post_fetch=post_fetch.sh
envs=proclaim,proclaim-pipeline
envs_optional=proclaim-pipeline
run=run_proclaim.sh
order=30
