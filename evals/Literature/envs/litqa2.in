# LitQA2, via AstaBench.
#
# The AstaBench clone is installed into this environment by
# ../AstaBench/post_install.sh, with --no-deps, so this lock stays the single
# authority on what is installed. The list below is AstaBench's own dependency
# set, transcribed from its pyproject.toml at the pinned commit
#
#     a9e338070ffff195cb4cc5ddcbcf9ca8805f141d
#
# which cannot move, so the transcription cannot drift: bump the pin in
# ../AstaBench/bench.manifest and this list is what has to be revisited with it.
#
# AstaBench itself requires Python >= 3.11.
-r _librarian.in

# ── AstaBench's own, from its pyproject at the pin ───────────────────────────
inspect_ai>=0.3.233,<0.3.259
agent-eval==0.1.54
openai>=2.30.0
pydantic>=2.11.4
pyyaml
litellm==1.88.1
datasets~=3.2.0
# Held below 1.0 deliberately. huggingface_hub 1.0 removed HfFolder, which
# AstaBench's LitQA2 task calls to resolve a Hub token; pinning under it is what
# makes that task run unmodified, instead of patching the clone to work around a
# dependency bump. datasets~=3.2.0 predates 1.0 too, so this is also the version
# the rest of the stack was built against.
huggingface_hub<1.0
google-genai>=1.70.0
nltk
tabulate
click==8.1.8
nora_lib-impl~=1.1.0
mcp~=1.10
httpx~=0.28.1
httpx-sse>=0.4.2
h2~=4.2.0
pandas
scipy
anthropic>=0.87.0
platformdirs
numpy

# ── Ours, on top ─────────────────────────────────────────────────────────────
opentelemetry-api      # bio_agent_wrapper propagates spans across threads
tqdm>=4.66
