# ScholarQA-Bench, scoring half: AutoAIS (citation correctness) and the two
# Prometheus judges.
#
# Derived from ScholarQABench's own requirements.txt (MIT; see
# ../SQA_bench/scorers/LICENSE), reduced to what our two scorers actually
# import. Upstream's Google API, Elasticsearch and diskcache pins are for
# scripts this harness never runs, and upstream's `vllm` line cannot install off
# Linux; the judges are served over an OpenAI-compatible endpoint instead, so
# nothing here loads them in-process.
#
# Resolved for Linux on purpose. This stack runs on a GPU box, and whoever
# regenerates the lock is unlikely to be sitting at one — without this, a relock
# on a Mac would quietly produce a lock that no GPU box can install.
# uv-compile-args: --python-platform x86_64-unknown-linux-gnu

# Upstream pinned torch==2.4.0+cu121, which cannot be installed from PyPI
# because of the local version suffix. Kept at that minor rather than left open:
# transformers is pinned at 4.44.0 (August 2024) and an unpinned torch resolves
# to a version years newer than anything this combination was ever run against.
torch>=2.4,<2.5        # AutoAIS: google/t5_xxl_true_nli_mixture
transformers==4.44.0
accelerate>=0.26.0
sentencepiece
protobuf
fschat                 # prometheus_eval: fastchat.conversation.get_conv_template
nltk                   # sentence splitting in the citation scorer
rouge_score
numpy<2
scipy
jsonlines
litellm                # run_utils: the judge over an OpenAI-compatible endpoint
tqdm>=4.66
