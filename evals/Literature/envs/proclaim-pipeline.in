# ProClaim-eval, arm 2: the full ProClaim pipeline on the librarian backend
# (paper row 0.80).
#
# This is ProClaim's own dependency set plus the librarian's. The list is
# transcribed from ProClaim's pyproject.toml at the pinned commit
#
#     6316258ba31386657389fea5bb2db2c97362e06c
#
# which cannot move, so the transcription cannot drift: bump the pin in
# ../ProClaim/bench.manifest and this list is what has to be revisited with it.
# Transcribed rather than resolved from the clone so that relocking does not
# require having cloned anything.
#
# Resolved for Linux: ProClaim pulls the nvidia CUDA wheels there, and the whole
# arm wants a GPU box for its evidence subagent anyway. Marked optional in the
# manifest, so a laptop can still set the bench up and run arm 1.
# uv-compile-args: --python-platform x86_64-unknown-linux-gnu
-r _librarian.in

# ── ProClaim's own, from its pyproject at the pin ────────────────────────────
pandas
torch==2.6.0
nvidia-cudnn-cu12; platform_system == 'Linux' and platform_machine == 'x86_64'
nvidia-nccl-cu12; platform_system == 'Linux' and platform_machine == 'x86_64'
