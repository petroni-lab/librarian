# See ../setup.sh for the format.
#
# Two environments: `sqa` generates answers and installs anywhere, `sqa-scoring`
# is the CUDA AutoAIS and Prometheus stack, built only when a run scores.
bench=sqa
name=ScholarQABench
url=https://github.com/AkariAsai/ScholarQABench.git
commit=95e6fc52b0a8a0ce0a74956029991e3bb00c38b9
clone=code
post_fetch=prepare_data.sh
post_install=post_install.sh
envs=sqa,sqa-scoring
# sqa-scoring installs only on Linux with CUDA, so a laptop can still set this
# bench up and generate answers.
envs_optional=sqa-scoring
run=run_sqa.sh
order=40
