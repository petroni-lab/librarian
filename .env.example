# LLM backend — any OpenAI-compatible /chat/completions endpoint.
# Copy this file to `.env` and edit the values.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=your-model-name
LLM_API_KEY=EMPTY
LLM_REASONING_EFFORT=low

# Optional Europe PMC cache (searches, full texts, supplementary files), so a
# paper is downloaded once instead of on every run. Off unless one is set; see
# librarian/literature_search.py. Redis needs `redis` installed.
# EPMC_CACHE_DIR=.epmc_cache
# EPMC_CACHE_REDIS_URL=redis://localhost:6379/0

# ── Benchmarks only (evals/Literature) ───────────────────────────────────────
# Not needed to run the librarian itself. `literature_eval.sh -h` lists what
# each bench requires.
# OPENAI_API_KEY=      # litqa2, labbench — answering model and open judge
# ANTHROPIC_API_KEY=   # proclaim — both arms use Sonnet 4.6
