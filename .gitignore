# AstaBench: a pinned, pristine clone. LitQA2's 91-question split is rebuilt on
# first use from the Hub; the committed id list beside it is what pins it.
evals/Literature/AstaBench/vendor/
evals/Literature/AstaBench/data/*/*
!evals/Literature/AstaBench/data/*/*_ids.txt
